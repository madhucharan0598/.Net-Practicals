@model Practical7.Models.Feedback

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Give Feedback</title>
</head>

<body>

    <h2>Student Feedback Form</h2>

    @using (Html.BeginForm())
    {
        @Html.LabelFor(model => model.EnrollmentNo)
        <br />
        @Html.EditorFor(model => model.EnrollmentNo)

        <br /><br />

        @Html.LabelFor(model => model.Name)
        <br />
        @Html.EditorFor(model => model.Name)

        <br /><br />

        @Html.LabelFor(model => model.Subject)
        <br />
        @Html.EditorFor(model => model.Subject)

        <br /><br />

        @Html.LabelFor(model => model.Rating)
        <br />
        @Html.EditorFor(model => model.Rating)

        <br /><br />

        @Html.LabelFor(model => model.Comments)
        <br />
        @Html.TextAreaFor(model => model.Comments, 5, 30, null)

        <br /><br />

        <input type="submit" value="Submit Feedback" />
    }

    <br /><br />

    @Html.ActionLink("Go Back To Home", "Index", "Feedback")

</body>
</html>