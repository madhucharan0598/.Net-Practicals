@model IEnumerable<Practical8.Models.Product>

<h2>Inventory Management</h2>

<p>
    @Html.ActionLink("Add New Product", "Create")
</p>

<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <th>Product Name</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Actions</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProductId</td>
            <td>@p.ProductName</td>
            <td>@p.Quantity</td>
            <td>@p.Price</td>
            <td>
                @Html.ActionLink("Edit", "Edit",
                    new { id = p.ProductId })

                @using (Html.BeginForm("Delete", "Inventory",
                    new { id = p.ProductId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="submit" value="Delete"
                           onclick="return confirm('Delete this product?');" />
                }
            </td>
        </tr>
    }
</table>